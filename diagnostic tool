    SerialBT.print("14 ");
    any = true;
  }

  if (b12 & 0x10)
  {
    SerialBT.print("15 ");
    any = true;
  }

  if (b12 & 0x08)
  {
    SerialBT.print("21 ");
    any = true;
  }

  if (b12 & 0x04)
  {
    SerialBT.print("22 ");
    any = true;
  }

  if (b12 & 0x02)
  {
    SerialBT.print("23 ");
    any = true;
  }

  if (b12 & 0x01)
  {
    SerialBT.print("24 ");
    any = true;
  }


  // BYTE 13

  if (b13 & 0x80)
  {
    SerialBT.print("25 ");
    any = true;
  }

  if (b13 & 0x20)
  {
    SerialBT.print("32 ");
    any = true;
  }

  if (b13 & 0x10)
  {
    SerialBT.print("33 ");
    any = true;
  }

  if (b13 & 0x08)
  {
    SerialBT.print("34 ");
    any = true;
  }

  if (b13 & 0x02)
  {
    SerialBT.print("41 ");
    any = true;
  }

  if (b13 & 0x01)
  {
    SerialBT.print("42 ");
    any = true;
  }


  // BYTE 14

  if (b14 & 0x80)
  {
    SerialBT.print("43 ");
    any = true;
  }

  if (b14 & 0x40)
  {
    SerialBT.print("44 ");
    any = true;
  }

  if (b14 & 0x20)
  {
    SerialBT.print("45 ");
    any = true;
  }

  if (b14 & 0x10)
  {
    SerialBT.print("51 ");
    any = true;
  }

  if (b14 & 0x08)
  {
    SerialBT.print("52 ");
    any = true;
  }

