  {
    SerialBT.print("54 ");
    any = true;
  }

  if (b14 & 0x01)
  {
    SerialBT.print("55 ");
    any = true;
  }


  if (!any)
  {
    SerialBT.print("NONE");
  }

  SerialBT.println();
}


// ============================================================
// DEKODOVANIE A20
// ============================================================

void decodeA20(uint8_t *frame, uint8_t length)
{
  if (length != 25)
    return;


  static unsigned long frameCounter = 0;

  frameCounter++;


  SerialBT.println();

  SerialBT.println(
    "================================"
  );


  SerialBT.print("FRAME #: ");
  SerialBT.println(frameCounter);


  SerialBT.print("TIME: ");
  SerialBT.print(
    millis() / 1000.0,
    1
  );
  SerialBT.println(" s");


  SerialBT.println(
    "FIREBIRD 2.8 V6 MPFI"
  );

  SerialBT.println(
    "--------------------------------"
  );


  // ==========================================================
  // RPM
  // ==========================================================

  int rpm =
    B(frame, 8) * 25;


  SerialBT.print("RPM: ");
  SerialBT.print(rpm);
  SerialBT.println(" rpm");


  // ==========================================================
  // COOLANT
  // ==========================================================

  uint8_t coolantRaw =
    B(frame, 5);

  float coolant =
    temperatureC(coolantRaw);


  SerialBT.print("COOLANT: ");
  SerialBT.print(coolant, 1);
  SerialBT.println(" C");


  SerialBT.print("COOLANT RAW: ");
  SerialBT.println(coolantRaw);


  // ==========================================================
  // MAT
  // ==========================================================

  uint8_t matRaw =
    B(frame, 16);

  float mat =
    temperatureC(matRaw);


  SerialBT.print("MAT: ");
  SerialBT.print(mat, 1);
  SerialBT.println(" C");


  SerialBT.print("MAT RAW: ");
  SerialBT.println(matRaw);


  // ==========================================================
  // TPS
  // ==========================================================

  float tps =
    B(frame, 9) * 0.019600;


  SerialBT.print("TPS: ");
  SerialBT.print(tps, 2);
  SerialBT.println(" V");


  // ==========================================================
  // SPEED
  // ==========================================================

  float speedKmh =
    B(frame, 6) * 1.60934;


  SerialBT.print("SPEED: ");
  SerialBT.print(speedKmh, 1);
  SerialBT.println(" km/h");


  // ==========================================================
  // IAC
  // ==========================================================

  SerialBT.print("IAC: ");
  SerialBT.print(B(frame, 4));
  SerialBT.println(" steps");


  // ==========================================================
  // O2 SENSOR
  // ==========================================================

  float o2 =
    B(frame, 11) * 4.44;


  SerialBT.print("O2: ");
  SerialBT.print(o2, 0);
  SerialBT.println(" mV");


  // ==========================================================
  // INT
  // ==========================================================

  SerialBT.print("INT: ");
  SerialBT.println(B(frame, 10));


  // ==========================================================
  // BLM
  // ==========================================================

  SerialBT.print("BLM: ");
  SerialBT.println(B(frame, 19));


  // ==========================================================
  // MAF
  // ==========================================================

  float maf =
    W(frame, 22) * 0.003906;


  SerialBT.print("MAF: ");
  SerialBT.print(maf, 2);
  SerialBT.println(" g/s");


  // ==========================================================
  // INJECTOR BPW
  // ==========================================================

  float injector =
    W(frame, 24) * 0.015300;


  SerialBT.print("INJ BPW: ");
  SerialBT.print(injector, 2);
  SerialBT.println(" ms");


  // ==========================================================
  // EGR
  // ==========================================================

  float egr =
    B(frame, 7) * 0.390625;


  SerialBT.print("EGR: ");
  SerialBT.print(egr, 1);
  SerialBT.println(" %");


  // ==========================================================
  // BYTE 17
  //
  // BIT 1 = FAN REQUEST
  // BIT 7 = A/C REQUEST
  // BIT 3 = POWER STEERING PRESSURE
  // ==========================================================

  uint8_t byte17 =
    B(frame, 17);


  // FAN
  // A20:
  // bit SET   = OFF
  // bit CLEAR = ON

  bool fanRequest =
    !(byte17 & 0x02);


  SerialBT.print("FAN REQUEST: ");

  SerialBT.println(
    fanRequest ? "ON" : "OFF"
  );


  // A/C REQUEST
  // A20:
  // bit CLEAR = YES
  // bit SET   = NO

  bool acRequest =
    !(byte17 & 0x80);


  SerialBT.print("A/C REQUEST: ");

  SerialBT.println(
    acRequest ? "YES" : "NO"
  );


  // ==========================================================
  // NOVINKA 1
  // POWER STEERING PRESSURE
  //
  // BYTE 17 BIT 3
  // SET = EXCESSIVE
  // ==========================================================

  bool powerSteeringPressure =
    byte17 & 0x08;


  SerialBT.print(
    "POWER STEERING PRESSURE: "
  );

  SerialBT.println(
    powerSteeringPressure
      ? "EXCESSIVE"
      : "NORMAL"
  );


  // BYTE17 RAW

  SerialBT.print("BYTE17 RAW: ");
  SerialBT.println(byte17);


  // BYTE17 BINARY

  SerialBT.print("BYTE17 BIN: ");

  printBinaryByte(byte17);

  SerialBT.println();


  // ==========================================================
  // BYTE 1
  //
  // BIT 7 = MAF PULSE
  // BIT 2 = CRANK PULSE
  // BIT 0 = VSS PULSE
  // BIT 5 = ALDL MODE
  // ==========================================================

  uint8_t byte1 =
    B(frame, 1);


  // ==========================================================
  // NOVINKA 2
  // MAF PULSE
  // ==========================================================

  bool mafPulse =
    byte1 & 0x80;


  SerialBT.print("MAF PULSE: ");

  SerialBT.println(
    mafPulse ? "YES" : "NO"
  );


  // ==========================================================
  // NOVINKA 3
  // VSS PULSE
  // ==========================================================

  bool vssPulse =
    byte1 & 0x01;


  SerialBT.print("VSS PULSE: ");

  SerialBT.println(
    vssPulse ? "YES" : "NO"
  );


  // ==========================================================
  // NOVINKA 4
  // CRANK PULSE
  // ==========================================================

  bool crankPulse =
    byte1 & 0x04;


  SerialBT.print("CRANK PULSE: ");

  SerialBT.println(
    crankPulse ? "YES" : "NO"
  );


  // ==========================================================
  // LOAD VARIABLE
  // ==========================================================

  SerialBT.print("LOAD: ");
  SerialBT.println(B(frame, 18));


  // ==========================================================
  // O2 CROSSOVER
  // ==========================================================

  SerialBT.print("O2 CROSS: ");
  SerialBT.println(B(frame, 20));


  // ==========================================================
  // LOOP STATUS
  //
  // BYTE 15 BIT 7
  // ==========================================================

  bool closedLoop =
    B(frame, 15) & 0x80;


  SerialBT.print("LOOP: ");

  SerialBT.println(
    closedLoop
      ? "CLOSED"
      : "OPEN"
  );


  // ==========================================================
  // RICH / LEAN
  //
  // BYTE 15 BIT 6
  // ==========================================================

  bool rich =
    B(frame, 15) & 0x40;


  SerialBT.print("MIXTURE: ");

  SerialBT.println(
    rich
      ? "RICH"
      : "LEAN"
  );


  // ==========================================================
  // BLM ENABLE
  //
  // BYTE 15 BIT 1
  // ==========================================================

  bool blmEnable =
    B(frame, 15) & 0x02;


  SerialBT.print("BLM ENABLE: ");

  SerialBT.println(
    blmEnable
      ? "YES"
      : "NO"
  );


  // ==========================================================
  // ALDL MODE
  //
  // BYTE 1 BIT 5
  // ==========================================================

  bool aldlMode =
    byte1 & 0x20;


  SerialBT.print("ALDL MODE: ");

  SerialBT.println(
    aldlMode
      ? "YES"
      : "NO"
  );


  // ==========================================================
  // DTC
  // ==========================================================

  printDTC(frame);


  SerialBT.println(
    "================================"
  );
}


// ============================================================
// SETUP
// ============================================================

void setup()
{
  Serial.begin(115200);

  SerialBT.begin(
    "FIREBIRD_ECM"
  );


  pinMode(
    ALDL_PIN,
    INPUT
  );


  attachInterrupt(
    digitalPinToInterrupt(ALDL_PIN),
    aldlISR,
    CHANGE
  );


  Serial.println(
    "FIREBIRD ECM MONITOR STARTED"
  );

  SerialBT.println(
    "FIREBIRD ECM MONITOR STARTED"
  );
}


// ============================================================
// LOOP
// ============================================================

void loop()
{
  static unsigned long lastDiagnostic = 0;

  static unsigned long previousBits = 0;

  static unsigned long previousIgnored = 0;

  static unsigned long previousInvalid = 0;

  static unsigned long lastGoodFrame = 0;


  // ----------------------------------------------------------
  // HOTOVY FRAME
  // ----------------------------------------------------------

  if (frameReady)
  {
    uint8_t localFrame[32];
    uint8_t localLength;


    noInterrupts();


    localLength =
      readyLength;


    for (
      uint8_t i = 0;
      i < localLength;
      i++
    )
    {
      localFrame[i] =
        readyFrame[i];
    }


    frameReady = false;


    interrupts();


    // A20 musi mat presne 25 bytov

    if (localLength == 25)
    {
      lastGoodFrame =
        millis();


      decodeA20(
        localFrame,
        localLength
      );
    }
  }


  // ----------------------------------------------------------
  // DIAGNOSTIKA SIGNALU KAZDE 2 SEKUNDY
  // ----------------------------------------------------------

  if (
    millis() - lastDiagnostic >= 2000
  )
  {
    lastDiagnostic =
      millis();


    unsigned long bitsNow;

    unsigned long ignoredNow;

    unsigned long invalidNow;


    noInterrupts();


    bitsNow =
      validBitsTotal;

    ignoredNow =
      ignoredEdgesTotal;

    invalidNow =
      invalidPulsesTotal;


    interrupts();


    unsigned long bitDifference =
      bitsNow - previousBits;


    unsigned long ignoredDifference =
      ignoredNow - previousIgnored;


    unsigned long invalidDifference =
      invalidNow - previousInvalid;


    previousBits =
      bitsNow;

    previousIgnored =
      ignoredNow;

    previousInvalid =
      invalidNow;


    unsigned long bitsPerSecond =
      bitDifference / 2;


    // --------------------------------------------------------
    // Ak uz dlhsie nemame dobry A20 frame
    // --------------------------------------------------------

    if (
      millis() - lastGoodFrame > 3000
    )
    {
      SerialBT.println();


      SerialBT.print("SIGNAL: ");

      if (bitsPerSecond > 0)
      {
        SerialBT.println("YES");
      }
      else
      {
        SerialBT.println("NO");
      }


      SerialBT.print("BITS/s: ");

      SerialBT.println(
        bitsPerSecond
      );


      SerialBT.print(
        "IGNORED NOISE/2s: "
      );

      SerialBT.println(
        ignoredDifference
      );


      SerialBT.print(
        "INVALID PULSES/2s: "
      );

      SerialBT.println(
        invalidDifference
      );


      SerialBT.print("SYNC: ");

      SerialBT.println(
        synced
          ? "YES"
          : "SEARCHING"
      );


      SerialBT.println(
        "WAITING FOR A20 FRAME..."
      );
    }
  }
}
